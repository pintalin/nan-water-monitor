# ── Work Time Tracker — Google Sheets ────────────────────────────────────────
# ID ของ Google Spreadsheet (จาก URL)
SPREADSHEET_ID=

# Service Account credentials (JSON ทั้งก้อน หรือใส่ path ไฟล์)
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Water Monitor — Telegram ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=ใส่_token_จาก_BotFather
TELEGRAM_CHAT_ID=ใส่_chat_id_กลุ่ม_เช่น_-100xxxxxxxxxx

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# ถ้าไม่ใส่ ระบบยังส่งรายงานได้แต่ไม่มีส่วน AI วิเคราะห์
ANTHROPIC_API_KEY=sk-ant-...

# ── กำลังผลิต (ลบ.ม./ชม.) ───────────────────────────────────────────────────
PROD_2_PUMP=750
PROD_1_PUMP=350

# ── ระดับเริ่มต้น (%) เมื่อยังไม่มี state.json ──────────────────────────────
INIT_PCT=80

# ── Schedule ──────────────────────────────────────────────────────────────────
# ส่งทุกชั่วโมงตั้งแต่ 17:00 ถึง 23:00
CRON_SCHEDULE=0 17-23 * * *
# ส่งทุกชั่วโมงตลอด 24 ชม. → CRON_SCHEDULE=0 * * * *

# ── Debug ─────────────────────────────────────────────────────────────────────
# ตั้งเป็น true เพื่อส่งรายงานทันทีเมื่อเปิดโปรแกรม
SEND_ON_START=false
